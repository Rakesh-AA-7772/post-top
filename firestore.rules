rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function validName(name) { return name is string && name.size() > 0 && name.size() <= 40; }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['name','ownerUid','content','imageUrl','reactions','timestamp'])
        && request.resource.data.keys().hasOnly(['name','ownerUid','content','imageUrl','reactions','timestamp'])
        && request.resource.data.ownerUid == request.auth.uid
        && validName(request.resource.data.name)
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 300
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 900000
        && (request.resource.data.imageUrl == '' ||
          request.resource.data.imageUrl.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'))
        && request.resource.data.reactions is map
        && request.resource.data.reactions.size() == 0
        && request.resource.data.timestamp == request.time;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());

      match /reactions/{userId} {
        allow read: if true;
        allow create, update: if signedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['ownerUid','emoji','timestamp'])
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.emoji in ['😂','💀','😭','🔥','❤️','👍','🤯','⚡','👎']
          && request.resource.data.timestamp == request.time;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /replies/{replyId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['postId','ownerUid','name','content','timestamp'])
        && request.resource.data.keys().hasOnly(['postId','ownerUid','name','content','timestamp'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postId.size() > 0
        && validName(request.resource.data.name)
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 300
        && request.resource.data.timestamp == request.time
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId));
      allow update: if false;
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /music/{musicId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['title','artist','mood','url','uploadedBy','ownerUid','timestamp'])
        && request.resource.data.keys().hasOnly(['title','artist','mood','url','uploadedBy','ownerUid','timestamp'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && request.resource.data.artist is string && request.resource.data.artist.size() > 0 && request.resource.data.artist.size() <= 100
        && (request.resource.data.mood == null || (request.resource.data.mood is string && request.resource.data.mood.size() <= 40))
        && request.resource.data.uploadedBy is string
        && request.resource.data.url is string && request.resource.data.url.size() <= 2048
        && request.resource.data.url.matches('https://res\\.cloudinary\\.com/.*')
        && request.resource.data.timestamp == request.time;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['recipientUid','actorUid','actorName','postId','type','read','createdAt'])
        && request.resource.data.keys().hasOnly(['recipientUid','actorUid','actorName','postId','type','read','createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() <= 40
        && request.resource.data.postId is string
        && request.resource.data.type in ['reply','reaction']
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.ownerUid == request.resource.data.recipientUid;
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if signedIn() && resource.data.recipientUid == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['reporterUid','postId','reason','createdAt','status'])
        && request.resource.data.keys().hasOnly(['reporterUid','postId','reason','createdAt','status'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.reason in ['spam','harassment','inappropriate','other']
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'open'
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId));
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}