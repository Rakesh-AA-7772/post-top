rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 40;
    }

    match /posts/{postId} {
      // The feed is public.
      allow read: if true;

      // A signed-in user may create only a post owned by their Firebase UID.
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'name', 'ownerUid', 'content', 'imageUrl', 'reactions', 'timestamp'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'ownerUid', 'content', 'imageUrl', 'reactions', 'timestamp'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && validName(request.resource.data.name)
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 300
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 900000
        && (
          request.resource.data.imageUrl == ''
          || request.resource.data.imageUrl.matches(
            'data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'
          )
        )
        && request.resource.data.reactions is map
        && request.resource.data.reactions.size() == 0
        && request.resource.data.timestamp == request.time;

      // Temporarily disabled: current client updates the whole reactions map,
      // which would let one user alter another user's reaction.
      allow update: if false;

      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /replies/{replyId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'postId', 'ownerUid', 'name', 'content', 'timestamp'
        ])
        && request.resource.data.keys().hasOnly([
          'postId', 'ownerUid', 'name', 'content', 'timestamp'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postId.size() > 0
        && validName(request.resource.data.name)
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 300
        && request.resource.data.timestamp == request.time
        && exists(
          /databases/$(database)/documents/posts/$(request.resource.data.postId)
        );

      // Replies are immutable from the client; only their owner can delete.
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /music/{musicId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'title', 'artist', 'mood', 'url', 'uploadedBy', 'ownerUid', 'timestamp'
        ])
        && request.resource.data.keys().hasOnly([
          'title', 'artist', 'mood', 'url', 'uploadedBy', 'ownerUid', 'timestamp'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.artist is string
        && request.resource.data.artist.size() > 0
        && request.resource.data.artist.size() <= 100
        && request.resource.data.mood is string
        && request.resource.data.mood.size() <= 40
        && request.resource.data.uploadedBy is string
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 2048
        && request.resource.data.url.matches('https://res\\.cloudinary\\.com/.*')
        && request.resource.data.timestamp == request.time;

      allow update: if false;
      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // No access to any collection unless explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}